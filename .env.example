# OLLAMA_BASE_URL: Base URL for the local Ollama API server.
OLLAMA_BASE_URL="http://localhost:11434"

# OLLAMA_MODEL: Local open-source model installed in Ollama (e.g., llama3.2:latest, qwen2.5:7b, mistral:latest).
OLLAMA_MODEL="llama3.2:latest"

# OLLAMA_TIMEOUT_SECONDS: Timeout in seconds for local Ollama inference calls.
OLLAMA_TIMEOUT_SECONDS="45"

# FLASK_PORT: Port when running the standalone Python Flask server directly (`python3 backend/app.py`).
FLASK_PORT="5001"
